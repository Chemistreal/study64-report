    "via": {
     "type": "string",
     "enum": [
      "speech",
      "manual"
     ],
     "description": "speech 말 판정기가 들었다 / manual 사람이 '했다' 를 눌렀다"
    },
    "attempts": {
     "type": "integer",
     "minimum": 0,
     "maximum": 99,
     "description": "해 본 횟수. 첫 시도가 1"
    },
    "repairs": {
     "type": "integer",
     "minimum": 0,
     "maximum": 99,
     "description": "고친 횟수. NPC 가 다시 해 보자고 했거나 팀이 되물은 횟수 (repair 는 실패가 정상)"
    },
    "pick": {
     "type": "string",
     "pattern": "^[a-z]{2,4}-[0-9]{1,3}$",
     "description": "선택 칸. 고른 후보 줄 id (그 차례 game.turns[].pick 중 하나, authored.json lines[].id). 말한 글이 아니고 줄 번호다. 말 판정기가 들은 줄이거나 사람이 누른 줄이고, 어느 줄인지 못 가렸거나 outcome 이 skipped 면 칸을 뺀다"
    }
   }
