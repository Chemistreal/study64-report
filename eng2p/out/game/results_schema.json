  },
  {
   "$ref": "#/$defs/activity"
  },
  {
   "$ref": "#/$defs/outing_turn"
  },
  {
   "$ref": "#/$defs/note"
  },
  {
   "$ref": "#/$defs/pause"
  }
 ],
 "$defs": {
  "session_start": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "v",
    "t",
    "s",
    "e",
    "device",
    "seat",
    "date",
    "t0",
    "t1",
    "mode",
    "seatA",
    "dataHash",
    "game"
   ],
   "properties": {
    "v": {
     "const": 1,
     "description": "계약 판 번호. sessions.json 의 schemaVersion 과 같다"
    },
    "t": {
     "const": "session_start",
     "description": "줄 종류"
    },
    "s": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9999,
     "description": "세션 번호. 비상판과 짧은 날도 그날 세션 번호를 쓴다 (번호는 안 오른다)"
    },
    "e": {
     "type": "string",
     "pattern": "^[hg][0-9]{14}-[0-9]{4,6}$",
     "description": "줄 번호. 기기 글자(h 방을 연 쪽, g 들어온 쪽) + 그 세션을 연 UTC 시각 YYYYMMDDHHMMSS + - + 그 기기가 쓴 차례. 세션 번호와 함께 합치기 열쇠다"
    },
    "device": {
     "type": "string",
     "enum": [
      "host",
      "guest"
     ],
     "description": "이 줄을 쓴 노트북. e 의 첫 글자와 맞아야 한다"
    },
    "seat": {
     "const": "team",
     "description": "이 줄은 한 사람의 값이 아니다"
    },
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "description": "세션을 연 날(현지 달력). 자정을 넘겨도 그 날이다"
    },
    "t0": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
     "description": "시작 UTC 시각"
    },
    "t1": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
     "description": "끝 UTC 시각. t0 이상"
    },
    "mode": {
     "type": "string",
     "enum": [
      "normal",
      "busy",
      "short"
     ],
     "description": "보통 날 블록 넷(1 40분, 2 30분, 3 시계 없음, 4 20분) / 바쁜 날 15분 혼자 / 짧은 날 예상 45분 둘이(시계로 자르지 않는다). busy 와 short 는 세션 번호를 안 올린다"
    },
    "seatA": {
     "type": "string",
     "enum": [
      "a",
      "b"
     ],
     "description": "그날 먼저 말을 여는 사람의 자리 (역할 A)"
    },
    "dataHash": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$",
     "description": "그때 읽은 Data/*.json 의 dataHash"
    },
    "game": {
     "type": "string",
     "pattern": "^[0-9A-Za-z._-]{1,16}$",
     "description": "게임 판 이름"
    }
   }
  },
